extends SceneTree
const Rules=preload('res://scripts/tactical/trial_rules.gd')
func _initialize():
	for deity in ['zeus','poseidon']:
		var r=Rules.new()
		assert(r.unlimited_powers)
		r.select_deity(deity)
		assert(not r.strike(Vector2(500,600)))
		r.deploy('legion',Vector2(650,420))
		r.start()
		for i in 30:assert(r.strike(Vector2(500,600)))
		assert(r.charges==2 and r.cooldown==0)
		assert(not r.strike(Vector2(-1,-1)))
		r.step(1.2)
		assert(r.waves.is_empty())
		r.phase='victory'
		assert(not r.strike(Vector2(500,600)))
		var limited=Rules.new(false)
		limited.select_deity(deity)
		limited.deploy('legion',Vector2(650,420))
		limited.start()
		assert(limited.strike(Vector2(500,600)))
		assert(not limited.strike(Vector2(500,600)))
		assert(limited.charges==1 and limited.cooldown==22)
	print('UNLIMITED: 30 consecutive casts per god, lifecycle, bounds and original limited mode PASS')
	quit()
